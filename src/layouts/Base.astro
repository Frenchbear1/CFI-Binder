---
import '../styles/global.css';
import { outline } from '../data/outline';
import { pagesIn } from '../data/tree';
import NavList from '../components/NavList.astro';

// guest: a page anyone can open without signing in (Interactives, sign-in). It carries none of the lessons:
// no contents list, no search, no editor.
interface Props { title: string; description?: string; isLesson?: boolean; isHome?: boolean; guest?: boolean; signin?: boolean; screen?: boolean }
const { title, description = 'A CFI teaching binder for Private, Instrument and Commercial students in the Cessna 172 and Piper PA-28-181.', isLesson = false, isHome = false, guest = false, signin = false, screen = false } = Astro.props;
const nav = guest ? [] : outline;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const here = Astro.url.pathname.replace(/\/$/, '');
const href = (slug: string) => base + slug + '/';
---
<!doctype html>
<html lang="en" data-level="pa" data-ac="both" data-panel="both">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title === 'CFI Binder' ? title : `${title} · CFI Binder`}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
  <link rel="manifest" href={base + 'manifest.webmanifest'} />
  <link rel="icon" href={base + 'icon-32.png'} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={base + 'icon-180.png'} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="CFI Binder" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <script is:inline>
    // Apply saved level + aircraft before first paint so nothing flickers.
    try {
      var d = document.documentElement, l = localStorage.getItem('cfi.level'), a = localStorage.getItem('cfi.ac');
      if (l) d.dataset.level = l; if (a) d.dataset.ac = a;
      var pn = localStorage.getItem('cfi.panel'); if (pn) d.dataset.panel = pn;
      // reading theme (Instant Search's), before anything paints
      var c = JSON.parse(localStorage.getItem('cfi.theme') || 'null');
      if (c && c.css && !c.auto) {
        d.setAttribute('style', c.css); d.dataset.theme = c.dark ? 'dark' : 'light';
        if (c.tint) { d.classList.add('doc-tint'); if (c.dark) d.classList.add('doc-dark'); }
        if (c.paper) d.classList.add('paper');
      } else d.classList.add('doc-tint');
      // a page edited on this device: hide the live copy until the saved one is swapped in
      var ob = JSON.parse(localStorage.getItem('cfi.outbox') || '{}'), here = decodeURIComponent(location.pathname), q = new URLSearchParams(location.search).get('p');
      if ((ob.pages || []).some(function (s) { return here.slice(-s.length - 2) === '/' + s + '/' || q === s; })) {
        d.classList.add('local-wait'); setTimeout(function () { d.classList.remove('local-wait'); }, 2500);
      }
    } catch (e) {}
  </script>
</head>
<body class:list={[{ home: isHome, guest, 'screen-page': screen }]} data-base={base} data-repo={import.meta.env.GITHUB_REPOSITORY || process.env.GITHUB_REPOSITORY || 'Frenchbear1/CFI-Binder'}>
  <a class="skip" href="#main">Skip to content</a>

  <header class="topbar">
    <a class="brand" href={base}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" fill="currentColor"/></svg>
      <span>CFI Binder</span>
    </a>
    <button class="searchfield" type="button" data-open="search" aria-label="Search the binder">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span>Search</span><kbd>/</kbd>
    </button>
    {isLesson && <button class="top-edit" type="button" data-edit-toggle aria-label="Edit this lesson" title="Edit this lesson"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="m13.5 6.5 4 4"/></svg></button>}
    {guest && <div class="guest-tools">
      <button class="icon-btn" type="button" data-open="prefs" aria-label="Settings and theme" title="Settings and theme"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2.2"/><circle cx="10" cy="17" r="2.2"/></svg></button>
      {!signin && <a class="signin-pill" href={base + 'login/'}>Sign in</a>}
    </div>}
    {!guest && <button class="icon-btn screen-btn" type="button" data-open="screen" aria-label="Student screen" title="Student screen"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></button>}
  </header>

  <div class="shell">
    <nav class="sidenav" aria-label="Binder contents">
      {nav.map((area) => (
        <div class="nav-area">
          <p class="nav-area-title">{area.title}</p>
          <NavList nodes={area.topics} here={here} />
        </div>
      ))}
    </nav>

    <main id="main">
      <slot />
    </main>

    {isLesson && (
      <aside class="toc-rail" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol class="toc" data-toc></ol>
      </aside>
    )}
  </div>

  <!-- Phone / tablet dock: one row, three targets. -->
  {!isHome && !guest && <div class="dock" role="toolbar" aria-label="Binder controls">
    <button class="dock-where" type="button" data-open="nav">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
      <span data-current>{isLesson ? title : 'Contents'}</span>
    </button>
    <button class="dock-icon" type="button" data-open="search" aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <button class="dock-chip" type="button" data-open="prefs" aria-label="Level and aircraft">
      <span data-chip-level>PVT</span><span class="dot">·</span><span data-chip-ac>Both</span><span data-chip-panel></span>
    </button>
  </div>}

  <!-- Sheets: bottom sheets on phones, centered panels on big screens. -->
  <dialog class="sheet" id="sheet-nav" aria-label="Contents">
    <div class="grab" aria-hidden="true"></div>
    {isLesson && (<>
      <p class="sheet-h">On this page</p>
      <ol class="toc" data-toc></ol>
    </>)}
    <p class="sheet-h">All lessons</p>
    <div class="sheet-nav">
      {nav.map((area) => (
        <details open={pagesIn(area.topics).some((t) => t.slug && here === base + t.slug)}>
          <summary>{area.title}</summary>
          <NavList nodes={area.topics} here={here} />
        </details>
      ))}
    </div>
  </dialog>

  <dialog class="sheet sheet-search" id="sheet-search" aria-label="Search">
    <div class="grab" aria-hidden="true"></div>
    <form class="search-box" role="search" onsubmit="return false">
      <button type="button" class="mode-pill" data-mode-pill-main aria-label="Search type"></button>
      <input type="search" placeholder="Search lessons, terms, V-speeds…" autocomplete="off" enterkeyhint="search" aria-label="Search" data-search-input />
      <button type="button" class="link-btn" data-close>Cancel</button>
    </form>
    <div class="search-results" data-search-results aria-live="polite">
      <p class="muted">Try “dihedral”, “stabilator”, “aft CG” or “spiral”.</p>
    </div>
  </dialog>

  <dialog class="sheet" id="sheet-prefs" aria-label="Level and aircraft">
    <div class="grab" aria-hidden="true"></div>
    <p class="sheet-h">Teaching a</p>
    <div class="seg seg-full" role="radiogroup" aria-label="Student level" data-pref="level">
      <button role="radio" data-v="pa">Private</button>
      <button role="radio" data-v="ir">Instrument</button>
      <button role="radio" data-v="ca">Commercial</button>
    </div>
    <p class="sheet-h">Aircraft</p>
    <div class="seg seg-full" role="radiogroup" aria-label="Aircraft" data-pref="ac">
      <button role="radio" data-v="both">Both</button>
      <button role="radio" data-v="c172">C172</button>
      <button role="radio" data-v="pa28">PA-28-181</button>
    </div>
    <p class="sheet-h">Instrument panel</p>
    <div class="seg seg-full" role="radiogroup" aria-label="Instrument panel" data-pref="panel">
      <button role="radio" data-v="both">Both</button>
      <button role="radio" data-v="analog">Round dials</button>
      <button role="radio" data-v="glass">Glass</button>
    </div>
    {isLesson && <button type="button" class="sheet-row" data-edit-toggle><span>Edit this lesson</span><span>Change anything ›</span></button>}
    <button type="button" class="sheet-row" data-open="theme"><span>Reading theme</span><span>Colours, paper ›</span></button>
    {!guest && <button type="button" class="sheet-row" data-open="screen"><span>Student screen</span><span data-scr-row>Connect an iPad ›</span></button>}
  </dialog>

  {!guest && <dialog class="sheet scr-sheet" id="sheet-screen" aria-label="Student screen">
    <div class="grab" aria-hidden="true"></div>
    <div class="scr-off" data-scr-off>
      <p class="sheet-h">Student screen</p>
      <p class="small">On the iPad, open <b data-scr-url></b>. Scan its code with this phone's camera, or type the code here:</p>
      <form class="scr-code" data-scr-form>
        <input data-scr-input placeholder="ABC123" maxlength="6" autocapitalize="characters" autocomplete="off" autocorrect="off" spellcheck="false" enterkeyhint="go" aria-label="Screen code" />
        <button type="submit" class="eb-save">Connect</button>
      </form>
      <p class="small muted" data-scr-msg></p>
    </div>
    <div class="scr-on" data-scr-on hidden>
      <div class="scr-top"><p class="sheet-h">Student screen <span class="scr-dot"></span> <span class="muted" data-scr-code></span></p>
        <button type="button" class="link-btn" data-scr-unpair>Disconnect</button></div>
      <p class="small muted" data-scr-hint>Tap <b>Show</b> on any picture, video or interactive to put it on the screen.</p>
      <div class="scr-ctl">
        <button type="button" data-scr-go="-1" aria-label="Previous slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
        <button type="button" data-scr-blank><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg><span>Blank</span></button>
        <button type="button" data-scr-go="1" aria-label="Next slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
      </div>
      <ol class="scr-deck" data-scr-deck></ol>
      <button type="button" class="link-btn scr-clear" data-scr-clear>Clear all slides</button>
    </div>
  </dialog>}

  <dialog class="sheet reader" id="sheet-reader" aria-label="Source reader">
    <div class="grab" aria-hidden="true"></div>
    <header class="rd-head">
      <div class="rd-title"><strong data-rd-label></strong> <span class="muted" data-rd-count></span><span class="rd-doc" data-rd-doc></span></div>
      <button type="button" class="rd-icon" data-rd-search aria-label="Search all sources" title="Search all sources"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <button type="button" class="rd-icon" data-rd-expand aria-label="Expand" title="Expand"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
      <button type="button" class="rd-icon" data-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </header>
    <div class="rd-searchbox">
      <div class="rd-qrow"><button type="button" class="mode-pill" data-mode-pill-rd aria-label="Search type"></button><input type="search" placeholder="Search every handbook in the binder…" aria-label="Search all sources" data-rd-q enterkeyhint="search" autocomplete="off" autocorrect="off" /></div>
      <div class="rd-chips" data-rd-chips></div>
      <div class="rd-results" data-rd-results></div>
    </div>
    <div class="rd-stage" data-rd-stage>
      <div class="rd-page" data-rd-page></div>
      <div class="rd-pagenav"><button type="button" class="rd-pagebtn" data-rd-prevpage hidden></button><span class="rd-swipe">Swipe for pages</span><button type="button" class="rd-pagebtn" data-rd-nextpage hidden></button></div>
    </div>
    <footer class="rd-foot">
      <button type="button" class="rd-step" data-rd-step data-rd-prev aria-label="Previous source">‹</button>
      <a class="rd-orig" data-rd-orig target="_blank" rel="noopener">Open original</a>
      <button type="button" class="rd-step" data-rd-step data-rd-next aria-label="Next source">›</button>
    </footer>
  </dialog>

  {isLesson && (<>
  <!-- Editor (Notion-style). Top: Done / status / more / Save. Bottom: the bar that sits on the keyboard. -->
  <header class="edit-head" hidden>
    <button type="button" class="eh-done" data-cmd="done">Done</button>
    <span class="eb-status" data-eb-status aria-live="polite"></span>
    <button type="button" class="eh-more" data-cmd="more" aria-label="More"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></button>
    <button type="button" class="eb-save" data-cmd="save" disabled>Save</button>
    <div class="eh-menu" data-more-menu hidden>
      <button type="button" data-cmd="source"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg>Edit page source</button>
      <button type="button" data-cmd="delpage" class="danger"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg><span>Delete this page</span></button>
    </div>
  </header>
  <div class="editbar" role="toolbar" aria-label="Editor" hidden>
    <div class="eb-view" data-view="main">
      <button type="button" data-cmd="find" aria-label="Search this page" title="Search this page"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <button type="button" data-cmd="add" aria-label="Add a block" title="Add a block"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
      <button type="button" data-cmd="text" aria-label="Text formatting" title="Text formatting" class="eb-aa">Aa</button>
      <button type="button" data-cmd="image" aria-label="Add a picture" title="Add a picture"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m21 16-5-5-8 8"/></svg></button>
      <button type="button" data-cmd="turn" aria-label="Turn into" title="Turn into"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h13l-3-3M20 15H7l3 3"/></svg></button>
      <button type="button" data-cmd="undo" aria-label="Undo" title="Undo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg></button>
      <button type="button" data-cmd="redo" aria-label="Redo" title="Redo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 14 5-5-5-5"/><path d="M20 9H10a6 6 0 0 0 0 12h3"/></svg></button>
    </div>
    <div class="eb-view" data-view="text" hidden>
      <button type="button" data-cmd="back" aria-label="Back" title="Back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m11 17-5-5 5-5M18 17l-5-5 5-5"/></svg></button>
      <button type="button" data-cmd="bold" aria-label="Bold" title="Bold"><b>B</b></button>
      <button type="button" data-cmd="italic" aria-label="Italic" title="Italic"><i style="font-family:Georgia,serif">I</i></button>
      <button type="button" data-cmd="underline" aria-label="Underline" title="Underline"><u>U</u></button>
      <button type="button" data-cmd="strikeThrough" aria-label="Strikethrough" title="Strikethrough"><s>S</s></button>
      <button type="button" data-cmd="link" aria-label="Link" title="Link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7L11.5 6.8"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.5-1.5"/></svg></button>
      <button type="button" data-cmd="ref" aria-label="Add a reference" title="Reference (PHAK 5-15, AIM 1-2-3, 14 CFR 91.3)" class="eb-ref">§</button>
    </div>
    <div class="eb-view eb-find" data-view="find" hidden>
      <button type="button" data-cmd="back" aria-label="Back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m11 17-5-5 5-5M18 17l-5-5 5-5"/></svg></button>
      <input type="search" placeholder="Search this page" data-find-input enterkeyhint="search" aria-label="Search this page" />
      <span class="find-n" data-find-n></span>
      <button type="button" data-cmd="findprev" aria-label="Previous match"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg></button>
      <button type="button" data-cmd="findnext" aria-label="Next match"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
    </div>
    <button type="button" class="eb-kb" data-cmd="kb" aria-label="Hide keyboard" title="Hide keyboard"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="12" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M7 12h10M9 20l3 2 3-2"/></svg></button>
  </div>
  <div class="blk-panel" data-panel hidden><p class="panel-h" data-panel-h></p><div data-panel-body></div></div>
  <div class="blk-tools" data-blk-tools hidden>
    <button type="button" data-act="add" aria-label="Add a block below" title="Add a block below">+</button>
    <button type="button" data-act="up" aria-label="Move up" title="Move up">↑</button>
    <button type="button" data-act="down" aria-label="Move down" title="Move down">↓</button>
    <button type="button" data-act="del" aria-label="Delete this block" title="Delete"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg></button>
  </div>
  <form class="eb-pop" data-eb-pop hidden>
    <label data-eb-label>Link to</label>
    <input data-eb-input autocomplete="off" />
    <button type="submit" class="eb-save">Add</button>
    <button type="button" class="eb-unlink" data-eb-unlink hidden>Remove link</button>
    <button type="button" class="eb-x" data-eb-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </form>

  <dialog class="sheet source-sheet" id="sheet-source" aria-label="Edit lesson source">
    <header class="src-head"><strong>Lesson source</strong><span class="muted small" data-src-note></span>
      <button type="button" class="eb-save" data-src-save>Save</button><button type="button" class="link-btn" data-close>Close</button></header>
    <textarea data-src-text spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
  </dialog>
  </>)}

  <dialog class="sheet" id="sheet-token" aria-label="Connect GitHub">
    <div class="grab" aria-hidden="true"></div>
    <p class="sheet-h">Connect your binder once</p>
    <p class="small">Upload sends your saved changes to the binder's GitHub repo, and the site updates about 2 minutes later. This needs a GitHub key that can only edit this one repo:</p>
    <ol class="small">
      <li>Open <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">GitHub › New fine-grained token</a>.</li>
      <li>Repository access: <b>Only select repositories</b> › <b>CFI-Binder</b>.</li>
      <li>Permissions › Repository › <b>Contents: Read and write</b>.</li>
      <li>Generate, copy it, and paste it here.</li>
    </ol>
    <form data-token-form class="token-form"><input type="password" placeholder="github_pat_…" data-token-input autocomplete="off" /><button type="submit" class="eb-save">Save key</button></form>
    <p class="muted small">The key stays on this device only.</p>
  </dialog>

  <script type="application/json" id="outline-data" set:html={JSON.stringify(nav)} />
  <script>
    import '../scripts/app.ts';
    import '../scripts/reader.ts';
    import '../scripts/editor.ts';
    import '../scripts/screen.ts';
  </script>
</body>
</html>
