---
import '../styles/global.css';
import { outline } from '../data/outline';

interface Props { title: string; description?: string; isLesson?: boolean }
const { title, description = 'A CFI teaching binder for Private, Instrument and Commercial students in the Cessna 172 and Piper PA-28-181.', isLesson = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const here = Astro.url.pathname.replace(/\/$/, '');
const href = (slug: string) => base + slug + '/';
---
<!doctype html>
<html lang="en" data-level="pa" data-ac="both">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title === 'CFI Binder' ? title : `${title} · CFI Binder`}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
  <link rel="manifest" href={base + 'manifest.webmanifest'} />
  <script is:inline>
    // Apply saved level + aircraft before first paint so nothing flickers.
    try {
      var d = document.documentElement, l = localStorage.getItem('cfi.level'), a = localStorage.getItem('cfi.ac');
      if (l) d.dataset.level = l; if (a) d.dataset.ac = a;
    } catch (e) {}
  </script>
</head>
<body data-base={base}>
  <a class="skip" href="#main">Skip to content</a>

  <header class="topbar">
    <a class="brand" href={base}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" fill="currentColor"/></svg>
      <span>CFI Binder</span>
    </a>
    <button class="searchfield" type="button" data-open="search" aria-label="Search the binder">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span>Search</span><kbd>/</kbd>
    </button>
    <div class="prefs-inline" aria-label="View settings">
      <div class="seg" role="radiogroup" aria-label="Student level" data-pref="level">
        <button role="radio" data-v="pa" title="Private">Private</button>
        <button role="radio" data-v="ir" title="Instrument">Instrument</button>
        <button role="radio" data-v="ca" title="Commercial">Commercial</button>
      </div>
      <div class="seg" role="radiogroup" aria-label="Aircraft" data-pref="ac">
        <button role="radio" data-v="both">Both</button>
        <button role="radio" data-v="c172">C172</button>
        <button role="radio" data-v="pa28">PA-28</button>
      </div>
    </div>
  </header>

  <div class="shell">
    <nav class="sidenav" aria-label="Binder contents">
      {outline.map((area) => (
        <div class="nav-area">
          <p class="nav-area-title">{area.title}</p>
          <ul>
            {area.topics.map((t) => (
              <li data-for={t.levels.join(' ')}>
                {t.slug
                  ? <a href={href(t.slug)} aria-current={here === (base + t.slug) ? 'page' : undefined}>{t.title}</a>
                  : <span class="planned" title="Coming soon">{t.title}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <main id="main">
      <slot />
    </main>

    {isLesson && (
      <aside class="toc-rail" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol class="toc" data-toc></ol>
      </aside>
    )}
  </div>

  <!-- Phone / tablet dock: one row, three targets. -->
  <div class="dock" role="toolbar" aria-label="Binder controls">
    <button class="dock-where" type="button" data-open="nav">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
      <span data-current>{isLesson ? title : 'Contents'}</span>
    </button>
    <button class="dock-icon" type="button" data-open="search" aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <button class="dock-chip" type="button" data-open="prefs" aria-label="Level and aircraft">
      <span data-chip-level>PVT</span><span class="dot">·</span><span data-chip-ac>Both</span>
    </button>
  </div>

  <!-- Sheets: bottom sheets on phones, centered panels on big screens. -->
  <dialog class="sheet" id="sheet-nav" aria-label="Contents">
    <div class="grab" aria-hidden="true"></div>
    {isLesson && (<>
      <p class="sheet-h">On this page</p>
      <ol class="toc" data-toc></ol>
    </>)}
    <p class="sheet-h">All lessons</p>
    <div class="sheet-nav">
      {outline.map((area) => (
        <details open={area.topics.some((t) => t.slug && here === base + t.slug)}>
          <summary>{area.title}</summary>
          <ul>
            {area.topics.map((t) => (
              <li data-for={t.levels.join(' ')}>
                {t.slug ? <a href={href(t.slug)}>{t.title}</a> : <span class="planned">{t.title}</span>}
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </dialog>

  <dialog class="sheet sheet-search" id="sheet-search" aria-label="Search">
    <div class="grab" aria-hidden="true"></div>
    <form class="search-box" role="search" onsubmit="return false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="Search lessons, terms, V-speeds…" autocomplete="off" enterkeyhint="search" aria-label="Search" data-search-input />
      <button type="button" class="link-btn" data-close>Cancel</button>
    </form>
    <div class="search-results" data-search-results aria-live="polite">
      <p class="muted">Try “dihedral”, “stabilator”, “aft CG” or “spiral”.</p>
    </div>
  </dialog>

  <dialog class="sheet" id="sheet-prefs" aria-label="Level and aircraft">
    <div class="grab" aria-hidden="true"></div>
    <p class="sheet-h">Teaching a</p>
    <div class="seg seg-full" role="radiogroup" aria-label="Student level" data-pref="level">
      <button role="radio" data-v="pa">Private</button>
      <button role="radio" data-v="ir">Instrument</button>
      <button role="radio" data-v="ca">Commercial</button>
    </div>
    <p class="sheet-h">Aircraft</p>
    <div class="seg seg-full" role="radiogroup" aria-label="Aircraft" data-pref="ac">
      <button role="radio" data-v="both">Both</button>
      <button role="radio" data-v="c172">C172</button>
      <button role="radio" data-v="pa28">PA-28-181</button>
    </div>
    <p class="muted small">Private shows the core lesson. Instrument and Commercial add the how and why, plus their tighter standards.</p>
  </dialog>

  <script>
    import '../scripts/app.ts';
  </script>
</body>
</html>
