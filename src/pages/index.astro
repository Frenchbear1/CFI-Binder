---
import Base from '../layouts/Base.astro';
import { outline } from '../data/outline';
import { treeHtml, allFolders } from '../data/tree';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const LV: Record<string, string> = { pa: 'Private', ir: 'Instrument', ca: 'Commercial' };
const folderIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>';
const pageIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4"/></svg>';
---
<Base title="Aviation Binder" isHome>
  <div class="nhome">
    <header class="nh-head">
      <span class="nh-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" fill="currentColor"/></svg></span>
      <h1>Aviation Binder</h1>
      <button class="nh-chip" type="button" data-open="prefs" aria-label="Level and aircraft">
        <span data-chip-level>PVT</span><span class="dot">·</span><span data-chip-ac>Both</span><span data-chip-panel></span>
      </button>
    </header>

    <p class="nh-notice" data-notice hidden></p>

    <section class="nh-recents" data-recents hidden>
      <p class="nh-label">Jump back in</p>
      <div class="nh-cards" data-recent-cards></div>
    </section>

    <p class="nh-label">Binder</p>
    <div class="tree" data-tree set:html={treeHtml(outline, { base })}></div>
    <div class="nh-upload">
      <button type="button" class="nh-up" data-upload disabled>Everything’s uploaded</button>
      <p class="muted small" data-upload-note></p>
    </div>
  </div>

  <div class="nh-bar">
    <button type="button" class="nh-search" data-open="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span>Search</span>
    </button>
    <button type="button" class="nh-compose" data-compose aria-label="New page or folder" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6"/><path d="M18.4 2.6a2 2 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
    </button>
    <div class="nh-pop" data-compose-menu hidden>
      <button type="button" data-new="page"><span class="ico" set:html={pageIcon} />New page</button>
      <button type="button" data-new="folder"><span class="ico" set:html={folderIcon} />New folder</button>
    </div>
  </div>

  <dialog class="sheet new-sheet" id="sheet-new" aria-label="New page">
    <div class="grab" aria-hidden="true"></div>
    <form data-new-form>
      <div class="new-top">
        <button type="button" class="link-btn" data-close>Cancel</button>
        <p class="sheet-h" data-new-h>New page</p>
        <button type="submit" class="eb-save" data-new-go>Create</button>
      </div>
      <div class="seg seg-full new-kind" role="radiogroup" aria-label="Make a">
        <button type="button" role="radio" data-kind="page" aria-checked="true">Page</button>
        <button type="button" role="radio" data-kind="folder" aria-checked="false">Folder</button>
      </div>
      <input class="new-title" name="title" placeholder="Untitled" autocomplete="off" required data-new-title />
      <label class="new-row"><span>In</span>
        <select name="area" data-new-area>
          {allFolders(outline).map((f) => <option value={f.at}>{'\u2003'.repeat(f.depth) + f.title}</option>)}
        </select>
      </label>
      <div data-page-only>
        <p class="new-row-l">Shows for</p>
        <div class="new-levels">
          {Object.entries(LV).map(([k, v]) => <label><input type="checkbox" name="lv" value={k} checked /> {v}</label>)}
        </div>
      </div>
      <p class="muted small" data-new-note>It’s saved to your binder and goes live in about 2 minutes.</p>
    </form>
  </dialog>
</Base>

<script>
  import '../scripts/home.ts';
</script>
