---
// Sign in to see the whole binder. The check happens on the server (api/login.js); without it you only get Interactives.
import Base from '../layouts/Base.astro';
import fbFile from '../data/firebase.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
// With a Firebase project, you sign in with your Google account (cloud.ts); before that, the username and password.
const fb = import.meta.env.PUBLIC_FIREBASE_CONFIG ? JSON.parse(import.meta.env.PUBLIC_FIREBASE_CONFIG) : fbFile;
const google = !!fb.projectId;
---
<Base title="Sign in" guest signin>
  <div class="signin">
    <div class="signin-card">
      <div class="signin-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" fill="currentColor"/></svg>
      </div>
      <h1>Welcome back</h1>
      <p class="signin-sub">{google ? 'Sign in with your Google account to open your binder. It syncs across your devices.' : 'Sign in to open your binder.'}</p>
      {google && <div class="signin-google" data-google>
        <button type="button" class="signin-go signin-g" data-google-go>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>
          <span>Continue with Google</span>
        </button>
        <p class="err" data-gerr hidden></p>
      </div>}
      <form method="post" action={`${base}api/login`} data-signin hidden={google}>
        <label class="field">
          <span>Username</span>
          <input name="user" autocomplete="username" autocapitalize="off" autocorrect="off" spellcheck="false" required />
        </label>
        <label class="field">
          <span>Password</span>
          <span class="pw">
            <input name="pass" type="password" autocomplete="current-password" required />
            <button type="button" class="pw-eye" data-eye aria-label="Show password" title="Show password">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </span>
        </label>
        <input type="hidden" name="next" data-next />
        <p class="err" data-err hidden>That username and password don't match.</p>
        <button type="submit" class="signin-go">Sign in</button>
      </form>
    </div>
    <a class="signin-alt" href={`${base}interactives/`}>Student? Open the Interactives <span aria-hidden="true">→</span></a>
  </div>
  {google && <script>
    import { signInWithGoogle, redirectUser, currentUser, serverSignIn, REDIRECTING } from '../scripts/cloud';
    const next = (() => { const n = new URLSearchParams(location.search).get('next') || '/'; return n.startsWith('/') && !n.startsWith('//') ? n : '/'; })();
    const btn = document.querySelector<HTMLButtonElement>('[data-google-go]')!;
    const err = document.querySelector<HTMLElement>('[data-gerr]')!;
    const label = btn.querySelector('span')!;
    const busy = (v: boolean, t = 'Signing in…') => { btn.disabled = v; label.textContent = v ? t : 'Continue with Google'; };
    const fail = (m: string) => { err.textContent = m; err.hidden = false; busy(false); };
    async function finish(user: import('firebase/auth').User) {
      busy(true);
      try { await serverSignIn(user); location.replace(next); }
      catch (e: any) { fail(e.message); }
    }
    // Back from Google (redirect), or already signed in with Google on this device: straight in.
    busy(true, 'Checking…');
    (async () => {
      // Just back from Google's page? Then say so if the account didn't come back, rather than quietly showing
      // the button again (which looks like sign-in starting over).
      let back = false; try { back = Date.now() - Number(sessionStorage.getItem(REDIRECTING) || 0) < 10 * 60e3; sessionStorage.removeItem(REDIRECTING); } catch {}
      let u = null, why = '';
      try { u = await redirectUser(); } catch (e: any) { why = e?.code || e?.message || String(e); }
      u ||= await currentUser().catch(() => null);
      if (u) finish(u);
      else if (back) fail(`Google didn’t send your account back to the binder${why ? ` (${why})` : ''}. Try again.`);
      else busy(false);
    })();
    btn.addEventListener('click', async () => {
      err.hidden = true; busy(true);
      try { const u = await signInWithGoogle(); if (u) finish(u); }
      catch (e: any) { fail(/popup-closed|cancelled/.test(e?.code || '') ? 'Sign-in was closed. Try again.' : `Couldn’t sign in with Google (${e?.code || e?.message || e}).`); }
    });
  </script>}
  <script is:inline>
    var q = new URLSearchParams(location.search);
    document.querySelector('[data-next]').value = q.get('next') || '/';
    if (q.get('e')) document.querySelector('[data-err]').hidden = false;
    var eye = document.querySelector('[data-eye]'), pw = document.querySelector('input[name=pass]');
    eye.addEventListener('click', function () { var s = pw.type === 'password'; pw.type = s ? 'text' : 'password'; eye.classList.toggle('on', s); eye.setAttribute('aria-label', s ? 'Hide password' : 'Show password'); });
    document.querySelector('[data-signin]').addEventListener('submit', function (e) { var b = e.target.querySelector('.signin-go'); b.disabled = true; b.textContent = 'Signing in…'; });
  </script>
</Base>
