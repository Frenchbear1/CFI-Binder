---
// Opened by scanning the student screen's QR code with the instructor's phone (signed in). src/scripts/screen.ts does the pairing.
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<Base title="Connect the student screen">
  <div class="signin" data-pair-page>
    <div class="signin-card">
      <div class="signin-mark" aria-hidden="true"><svg viewBox="0 0 24 24" style="transform:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></div>
      <h1>Connecting…</h1>
      <p class="signin-sub">Pairing this device with the student screen.</p>
      <a class="signin-go pair-next" href={base} data-pair-next hidden>Open the binder</a>
    </div>
  </div>
</Base>
