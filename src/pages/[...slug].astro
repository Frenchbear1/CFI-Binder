---
import { getCollection, render } from 'astro:content';
import Lesson from '../layouts/Lesson.astro';
// Every lesson can use these without importing them (pages made in the app have no imports).
import Level from '../components/Level.astro';
import Panel from '../components/Panel.astro';
import Compare from '../components/Compare.astro';
import Specs from '../components/Specs.astro';
import Callout from '../components/Callout.astro';
import Figure from '../components/Figure.astro';
import Video from '../components/Video.astro';
import Toggle from '../components/Toggle.astro';
import Refs from '../components/Refs.astro';
import AC from '../components/AC.astro';
import R from '../components/R.astro';
import Columns from '../components/Columns.astro';
import Col from '../components/Col.astro';
import Embed from '../components/Embed.astro';
import Bookmark from '../components/Bookmark.astro';
import PageLink from '../components/PageLink.astro';
import FileLink from '../components/FileLink.astro';
const components = { Level, Panel, Compare, Specs, Callout, Figure, Video, Toggle, Refs, AC, R, Columns, Col, Embed, Bookmark, PageLink, FileLink };
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((l) => ({ params: { slug: l.id }, props: { l } }));
}
const { l } = Astro.props;
const { Content } = await render(l);
---
<Lesson title={l.data.title} summary={l.data.summary} area={l.data.area} acs={l.data.acs} updated={l.data.updated} file={l.filePath} slug={l.id}>
  <Content components={components} />
</Lesson>
