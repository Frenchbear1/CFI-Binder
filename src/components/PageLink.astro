---
// Link to another page in the binder: <PageLink to="aerodynamics/stability" />
import { outline } from '../data/outline';
import { pagesIn } from '../data/tree';
const { to, title } = Astro.props as { to: string; title?: string };
const t = title || pagesIn(outline).find((x) => x.slug === to)?.title || to;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<a class="pagelink" href={base + to + '/'} data-pagelink={to}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4M10 14l4-4M11 10h3v3"/></svg><span>{t}</span></a>
