---
// Click-to-load video embed. Shows a thumbnail; the real player (with its own controls)
// loads only on tap, so pages stay fast. Supports YouTube, Vimeo, or a direct file (src).
interface Props {
  youtube?: string; vimeo?: string; src?: string; poster?: string;
  title: string; channel?: string; start?: number; note?: string; compact?: boolean;
}
const { youtube, vimeo, src, poster, title, channel, start, note, compact = false } = Astro.props;
const provider = youtube ? 'youtube' : vimeo ? 'vimeo' : 'file';
const vid = youtube || vimeo;
const thumb = poster || (youtube ? `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg` : undefined);
const watch = youtube ? `https://www.youtube.com/watch?v=${youtube}${start ? `&t=${start}s` : ''}` : vimeo ? `https://vimeo.com/${vimeo}` : src;
// Engagement saved by scripts/video-stats.mjs (YouTube Data API), shown so the pick can be judged at a glance.
import { existsSync, readFileSync } from 'node:fs';
const statsFile = 'public/library/videos.json';
const st = youtube && existsSync(statsFile) ? JSON.parse(readFileSync(statsFile, 'utf8')).videos?.[youtube] : undefined;
const fmt = (x: number) => (x >= 1e6 ? (x / 1e6).toFixed(1).replace(/\.0$/, '') + 'M' : x >= 1e3 ? Math.round(x / 1e3) + 'K' : String(x));
const statLine = st ? `${fmt(st.views)} views · ${fmt(st.likes)} likes · ${fmt(st.comments)} comments` : '';
const mm = start ? `${Math.floor(start / 60)}:${String(start % 60).padStart(2, '0')}` : '';
---
<figure class:list={['video', { compact }]}>
  <div class="video-frame">
    {provider === 'file'
      ? <video controls preload="none" playsinline poster={poster} src={src} title={title}></video>
      : <button type="button" data-video data-provider={provider} data-vid={vid} data-start={start} data-watch={watch} aria-label={`Play: ${title}`} style={thumb ? `background-image:url(${thumb})` : undefined}>
          <span class="play" aria-hidden="true"></span>
          <span class="video-label">{title}</span>
        </button>}
  </div>
  <figcaption>
    <strong>{title}</strong>{channel && <> · {channel}</>}{mm && <> · starts at {mm}</>}
    {statLine && <><br /><span class="video-stats" title={`Checked ${st.checked}`}>{statLine}</span></>}
    {note && <><br />{note}</>}
    {watch && <> · <a href={watch}>Open on {provider === 'youtube' ? 'YouTube' : provider === 'vimeo' ? 'Vimeo' : 'source'}</a></>}
  </figcaption>
</figure>
