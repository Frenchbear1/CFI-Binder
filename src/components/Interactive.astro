---
// One of the binder's sims (from Aviation Interactives, in public/sims/), part of the lesson: it takes on
// the reading theme and fonts and grows to its full height, so it scrolls with the page.
import data from '../data/interactives.json';
interface Props { id: string; title?: string }
const { id, title } = Astro.props;
const sim = data.items.find((s) => s.id === id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
{sim && (
  <figure class="sim" data-sim={id}>
    <iframe class="sim-frame" src={`${base}${data.site}${sim.path}`} title={title || sim.name} loading="lazy" data-sim-frame></iframe>
    <figcaption><span>{title || sim.name}</span> · <a href={`${base}interactives/${id}/`}>Full screen</a></figcaption>
  </figure>
)}
