---
// One of the binder's sims (src/sims/<id>/), running right in the page: it uses the reading theme and fonts,
// In a lesson it waits behind a Start card (nothing runs until you tap it); full: the sim's own page, which starts
// straight away (its keyboard shortcuts always work there).
import data from '../data/interactives.json';
import { THUMBS } from '../data/thumbs';
import '../sims/palette.css';
import '../sims/kit.css';
interface Props { id: string; title?: string; full?: boolean }
const { id, title, full } = Astro.props;
const sim = data.items.find((s) => s.id === id);
const markup = import.meta.glob('../sims/*/markup.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
import.meta.glob('../sims/*/style.css', { eager: true });
const html = markup[`../sims/${id}/markup.html`] || '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
{sim && (
  <figure class:list={['sim', { 'sim-full': full }]} data-sim-box={id} data-pagefind-ignore>
    <template data-sim-tpl={id} set:html={html} />
    {!full && (
      <button type="button" class="sim-start" data-sim-start>
        <span class="sim-start-art" set:html={THUMBS[id] || ''} />
        <span class="sim-start-txt"><small>{sim.tag.split(' · ')[0]}</small><b>{title || sim.name}</b></span>
        <span class="sim-start-go"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>Start</span>
      </button>
    )}
    <div class={`sim-root sim-${id}`} data-sim={id} data-sim-full={full ? '' : undefined} data-wait={full ? undefined : ''} hidden={!full} aria-label={title || sim.name}></div>
    {!full && <figcaption><span>{title || sim.name}</span> · <a href={`${base}interactives/${id}/`}>Full screen</a></figcaption>}
  </figure>
)}
<script>
  import { bootSims } from '../sims/runtime.js';
  bootSims();
  document.addEventListener('cfi:article', () => bootSims());
  // Start: open the interactive up and run it.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-sim-start]');
    if (!b || b.closest('[contenteditable="true"]')) return;
    const fig = b.closest<HTMLElement>('figure.sim'), root = fig?.querySelector<HTMLElement>('.sim-root');
    if (!fig || !root) return;
    e.preventDefault();
    b.hidden = true; root.hidden = false; root.removeAttribute('data-wait');
    bootSims(fig);
  });
</script>
