---
// Notion-style toggle: collapsed detail that keeps phone pages short.
interface Props { title: string; open?: boolean; heading?: 1 | 2 | 3 }
const { title, open = false, heading } = Astro.props;
---
<details class:list={["toggle", heading && `toggle-h${heading}`]} open={open}>
  <summary>{title}</summary>
  <div class="toggle-body"><slot /></div>
</details>
