---
// Original diagram: CG ahead of center of lift, balanced by tail-down force.
---
<svg viewBox="0 0 720 270" role="img" aria-label="Side view: weight acts at the CG ahead of the center of lift, creating a nose-down moment that the horizontal tail balances with a downward force.">
  <style>
    .body { fill: var(--surface-2); stroke: var(--ink-2); stroke-width: 2; }
    .lbl { fill: var(--ink); font: 600 14px var(--font); }
    .sub { fill: var(--ink-3); font: 12.5px var(--font); }
    .up { stroke: var(--pa); stroke-width: 4; marker-end: url(#hu); }
    .dn { stroke: var(--pa28); stroke-width: 4; marker-end: url(#hd); }
    .tl { stroke: var(--ir); stroke-width: 4; marker-end: url(#ht); }
  </style>
  <defs>
    <marker id="hu" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0,0 L10,5 L0,10z" fill="var(--pa)"/></marker>
    <marker id="hd" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0,0 L10,5 L0,10z" fill="var(--pa28)"/></marker>
    <marker id="ht" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0,0 L10,5 L0,10z" fill="var(--ir)"/></marker>
  </defs>
  <!-- fuselage -->
  <path class="body" d="M90,140 C100,112 150,104 230,104 L470,118 L600,122 L605,140 L470,150 L230,160 C150,160 100,156 90,140 Z" />
  <path class="body" d="M560,122 L585,60 L612,60 L605,122 Z" />
  <path class="body" d="M540,136 L640,132 L640,140 L545,142 Z" />
  <rect x="232" y="100" width="110" height="10" rx="5" fill="var(--ink-2)" />
  <circle cx="98" cy="140" r="5" fill="var(--ink-2)" />
  <!-- CG mark -->
  <g transform="translate(262 132)"><circle r="11" fill="var(--surface)" stroke="var(--ink)" stroke-width="2"/><path d="M0,-11 A11,11 0 0 1 11,0 L0,0Z M0,11 A11,11 0 0 1 -11,0 L0,0Z" fill="var(--ink)"/></g>
  <!-- forces -->
  <line class="up" x1="300" y1="100" x2="300" y2="30" />
  <text x="312" y="40" class="lbl">Lift</text><text x="312" y="56" class="sub">(center of lift, behind CG)</text>
  <line class="dn" x1="262" y1="146" x2="262" y2="222" />
  <text x="160" y="214" class="lbl">Weight</text><text x="128" y="230" class="sub">acts at CG</text>
  <line class="tl" x1="600" y1="146" x2="600" y2="206" />
  <text x="500" y="230" class="lbl">Tail-down force</text><text x="470" y="248" class="sub">balances the nose-down tendency</text>
  <path d="M190,70 A90,90 0 0 0 175,150" fill="none" stroke="var(--ink-3)" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#hd)" />
  <text x="40" y="70" class="sub">nose-down moment</text>
  <text x="40" y="86" class="sub">(CG ahead of lift)</text>
</svg>
