---
// Original diagram: washout, root at higher incidence than the tip, so the root stalls first.
const foil = 'M0,0 C18,-13 70,-14 150,0 C70,5 18,6 0,0Z';
---
<svg viewBox="0 0 720 210" role="img" aria-label="Wing root airfoil at a higher angle than the wingtip airfoil. The root reaches the critical angle of attack first, so the tips and ailerons keep flying.">
  <style>
    .f { fill: var(--surface-2); stroke: var(--ink-2); stroke-width: 2; }
    .rw { stroke: var(--ink-3); stroke-width: 1.5; marker-end: url(#wa); }
    .t { fill: var(--ink); font: 700 15px var(--font); text-anchor: middle; }
    .s { fill: var(--ink-3); font: 13px var(--font); text-anchor: middle; }
    .stall { fill: none; stroke: var(--pa28); stroke-width: 1.8; stroke-dasharray: 3 4; }
  </style>
  <defs><marker id="wa" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10z" fill="var(--ink-3)"/></marker></defs>
  <line class="rw" x1="40" y1="110" x2="110" y2="110" /><text x="70" y="98" class="s">wind</text>
  <g transform="translate(140 110) rotate(-12)"><path class="f" d={foil} /></g>
  <path class="stall" d="M210,78 q15,8 30,0 q15,-8 30,0 q12,6 22,4" />
  <text x="215" y="160" class="t">Wing root</text>
  <text x="215" y="178" class="s">More angle → stalls first, buffet warns you</text>
  <line class="rw" x1="400" y1="110" x2="470" y2="110" /><text x="430" y="98" class="s">wind</text>
  <g transform="translate(500 110) rotate(-6)"><path class="f" d={foil} /></g>
  <text x="575" y="160" class="t">Wingtip (aileron)</text>
  <text x="575" y="178" class="s">Less angle → still flying, ailerons still work</text>
</svg>
