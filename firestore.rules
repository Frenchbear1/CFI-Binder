rules_version = '2';
// Only the binder's owner (one Google account) can read or write anything. Paste this into
// Firebase console > Firestore Database > Rules, with your Google address in place of the one below.
// api/login.js relies on this too: whoever Firestore lets read binder/meta is let into the binder.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'your.address@gmail.com';
    }
  }
}
