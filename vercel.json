{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "node scripts/fetch-sources.mjs && node scripts/video-stats.mjs && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/notion.js": {
      "maxDuration": 60
    },
    "api/login.js": {
      "includeFiles": "src/data/firebase.json"
    }
  }
}
